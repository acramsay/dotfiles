{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "plugins": [
    "@cortexkit/aft-opencode"
  ],
  "keybinds": {
    "session.tab.next": "ctrl+l",
    "session.tab.previous": "ctrl+h",
    "session.message.next": "ctrl+j",
    "session.message.previous": "ctrl+k",
    "input.newline": "shift+return,ctrl+return,alt+return",
    "input.delete.to.line.end": "none"
  },
  "scroll": {
    "speed": 5
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "terminal": {
    "title": false
  },
  "animations": true
}
