{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "plugins": [
    "@cortexkit/aft-opencode",
    "./plugins/models-md-tui.tsx"
  ],
  "scroll": {
    "speed": 5
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide"
  },
  "terminal": {
    "title": false
  },
  "animations": true
}
