{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "enabled_providers": ["anthropic","openrouter","vercel"],
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "formatter": {
    "rumdl": {
      "command": ["rumdl", "fmt", "$FILE"],
      "extensions": [".md"]
    },
    "gopls": {
      "disabled": true
    },
    "gofumpt": {
      "command": ["gofumpt", "$FILE"],
      "extensions": [".go"]
    },
    "ruff": {
      "disabled": true
    }
  },
  "lsp": {
    "rumdl": {
      "command": ["rumdl", "server"],
      "extensions": [".md"]
    },
    "golangci-lint": {
      "command": ["golangci-lint-langserver"],
      "extensions": [".go"],
      "initialization": {
        "command": ["golangci-lint", "run", "--output.json.path", "stdout", "--show-stats=false", "--issues-exit-code=1"]
      }
    }
  },
  "permission": {
    "question": "deny",
    "bash": {
      "*": "allow",
      "python*": "deny"
    },
    "external_directory": {
      "~/git/dotfiles/**": "allow",
      "~/.config/helix/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.cache/opencode/**": "allow",
      "~/.cache/aft/**": "allow",
      "~/.local/share/cortexkit/**": "allow",
      "~/.local/share/opencode/bin/**": "allow",
      "~/.local/share/opencode/log/**": "allow",
      "~/.local/share/opencode/project/**": "allow",
      "~/.local/share/opencode/repos/**": "allow",
      "~/.local/share/opencode/snapshot/**": "allow",
      "~/.local/share/opencode/storage/**": "allow",
      "~/.local/share/opencode/tool-output/**": "allow"
    }
  },
  "plugin": [
    "@ex-machina/opencode-anthropic-auth",
    "@tarquinen/opencode-dcp@3.1.13",
    "@cortexkit/aft-opencode@latest",
    "opencode-pty"
  ],
  "provider": {
    "openrouter": {
      "models": {
        "xiaomi/mimo-v2.5": {
          "name": "Xiaomi MiMo v2.5",
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    }
  }
}
