{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "openrouter", "effect": "allow" }
    ]
  },
  "formatter": {
    "rumdl": {
      "command": ["rumdl", "fmt", "$FILE"],
      "extensions": [".md"]
    },
    "gopls": {
      "disabled": true
    },
    "gofumpt": {
      "command": ["gofumpt", "$FILE"],
      "extensions": [".go"]
    },
    "ruff": {
      "disabled": true
    }
  },
  "permissions": [
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "python*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/git/dotfiles/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/helix/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.cache/aft/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/cortexkit/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/bin/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/log/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/project/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/repos/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/snapshot/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/storage/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/tool-output/**", "effect": "allow" }
  ],
  "plugins": [
    "@tarquinen/opencode-dcp",
    "@cortexkit/aft-opencode",
    "@acramsay/opencode-veil",
    "@acramsay/opencode-shield-bash",
    "@acramsay/opencode-models-md"
  ]
}
