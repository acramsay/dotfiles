{
  "$schema": "https://raw.githubusercontent.com/cortexkit/aft/main/assets/aft.schema.json",
  "format_on_edit": true,
  "search_index": true,
  "semantic_search": true,
  "lsp": {
    // Enable to inline diagnostics after each edit. Off until AFT #305 is fixed;
    // while on, every markdown edit reports "did not respond in time: rumdl".
    // "diagnostics_on_edit": true,
    "servers": {
      "rumdl": {
        "extensions": ["md"],
        "binary": "rumdl",
        "args": ["server"],
        "root_markers": [".git", ".rumdl.toml"]
      }
    }
  }
}
