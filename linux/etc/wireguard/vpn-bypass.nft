# Bypass routing for the Proton tunnel; see docs/vpn.md ("Bypass mechanism").
table ip vpn_bypass {
    set bypass {
        type ipv4_addr
    }
    chain prerouting_mark {
        type filter hook prerouting priority mangle + 1; policy accept;
        ip daddr @bypass meta mark set meta mark | 0x100
    }
    chain output_mark {
        type route hook output priority mangle; policy accept;
        ip daddr @bypass meta mark set meta mark | 0x100
    }
    chain postrouting_snat {
        type nat hook postrouting priority srcnat; policy accept;
        ip daddr @bypass meta mark & 0x100 == 0x100 masquerade
    }
}
